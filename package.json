{
  "name": "web-terminal",
  "version": "1.0.0",
  "description": "Browser-based terminal manager for Windows — multi-session, multi-server cluster, PWA, and Claude Code hook integration.",
  "keywords": [
    "terminal",
    "web-terminal",
    "node-pty",
    "websocket",
    "pwa",
    "windows",
    "claude-code",
    "xterm",
    "remote-shell"
  ],
  "homepage": "https://github.com/Adiel-Sharabi/web-terminal#readme",
  "bugs": {
    "url": "https://github.com/Adiel-Sharabi/web-terminal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Adiel-Sharabi/web-terminal.git"
  },
  "license": "MIT",
  "author": "Adiel Sharabi",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node monitor.js",
    "start:server": "node server.js",
    "test": "playwright test",
    "lint": "eslint .",
    "syntax-check": "node -c server.js && node -c monitor.js && node -c pty-worker.js",
    "check:links": "node scripts/check-links.js",
    "check:secrets": "node scripts/check-no-secrets.js",
    "check": "npm run syntax-check && npm run lint && npm run check:links && npm run check:secrets"
  },
  "dependencies": {
    "express": "^4.22.2",
    "express-ws": "^5.0.2",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.39.5",
    "globals": "^17.7.0"
  }
}
